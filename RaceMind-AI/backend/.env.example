ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://racemind:racemind@localhost:5432/racemind

# Generate a real one for anything beyond local dev: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

LOG_LEVEL=INFO

UDP_DEFAULT_HOST=0.0.0.0
UDP_DEFAULT_PORT=20777

# Leave blank to disable the AI Engineer - it fails closed (503) rather
# than crash the app when this isn't set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
